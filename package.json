{
  "name": "dify-code-assistant",
  "displayName": "Dify Code Assistant",
  "description": "基于 Dify 的 VS Code AI 编程助手，支持智能对话、代码补全、代码解释和重构",
  "version": "0.2.0",
  "publisher": "dirjaker",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "AI",
    "Chat"
  ],
  "icon": "resources/icon.png",
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dify-sidebar",
          "title": "Dify AI",
          "icon": "resources/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "dify-sidebar": [
        {
          "type": "webview",
          "id": "difyChatView",
          "name": "AI 助手"
        }
      ]
    },
    "commands": [
      {
        "command": "dify.openChat",
        "title": "打开 AI 助手",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "dify.explainCode",
        "title": "AI: 解释代码",
        "icon": "$(book)"
      },
      {
        "command": "dify.refactorCode",
        "title": "AI: 重构代码",
        "icon": "$(wrench)"
      },
      {
        "command": "dify.fixCode",
        "title": "AI: 修复代码",
        "icon": "$(bug)"
      },
      {
        "command": "dify.completeCode",
        "title": "AI: 生成代码",
        "icon": "$(sparkle)"
      },
      {
        "command": "dify.settings",
        "title": "AI: 设置",
        "icon": "$(gear)"
      }
    ],
    "configuration": {
      "title": "Dify Code Assistant",
      "properties": {
        "dify.apiUrl": {
          "type": "string",
          "default": "http://192.168.31.100:9000",
          "description": "Dify API 地址"
        },
        "dify.apiKey": {
          "type": "string",
          "default": "",
          "description": "Dify API Key (app-xxx)"
        },
        "dify.model": {
          "type": "string",
          "default": "deepseek-v4-pro",
          "description": "使用的模型名称"
        },
        "dify.enableAutocomplete": {
          "type": "boolean",
          "default": true,
          "description": "启用内联代码补全"
        },
        "dify.maxTokens": {
          "type": "number",
          "default": 4096,
          "description": "最大响应 token 数"
        }
      }
    },
    "keybindings": [
      {
        "command": "dify.openChat",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dify.explainCode",
          "when": "editorHasSelection",
          "group": "dify@1"
        },
        {
          "command": "dify.fixCode",
          "when": "editorHasSelection",
          "group": "dify@2"
        },
        {
          "command": "dify.refactorCode",
          "when": "editorHasSelection",
          "group": "dify@3"
        },
        {
          "command": "dify.completeCode",
          "when": "editorHasSelection",
          "group": "dify@4"
        }
      ],
      "commandPalette": [
        {
          "command": "dify.explainCode",
          "when": "editorHasSelection"
        },
        {
          "command": "dify.fixCode",
          "when": "editorHasSelection"
        },
        {
          "command": "dify.refactorCode",
          "when": "editorHasSelection"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dirjaker/dify-code-assistant.git"
  }
}
